{
  "rules": {
    ".read": false,
    ".write": false,

    "farms": {
      "$farm": {
        ".read": "auth != null && root.child('acl/viewers').child(auth.uid).val() === true",
        ".write": false,

        // Append-only command queue: the only client-writable path in the tree.
        // A controller may create a command and nothing else - no editing one,
        // no deleting one, no writing anywhere else under the farm. The bridge
        // on the NUC holds the only credential that can act on or remove one,
        // and re-applies its own domain allow-list, so a mistake here cannot by
        // itself reach a relay.
        "commands": {
          "$cmd": {
            ".write": "auth != null && root.child('acl/controllers').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['entity_id','domain','service','uid','at'])",

            "entity_id": {
              ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().matches(/^[a-z_]+[.][a-z0-9_]+$/)"
            },
            // Only these four domains, and the domain must be the one the
            // entity_id names. cover, lock and alarm_control_panel are absent
            // on purpose - operating a gate or a door lock from a browser tab
            // is a separate decision, not a config tweak.
            "domain": {
              ".validate": "newData.isString() && newData.val().matches(/^(switch|light|fan|input_boolean)$/) && newData.parent().child('entity_id').val().beginsWith(newData.val() + '.')"
            },
            "service": {
              ".validate": "newData.isString() && newData.val().matches(/^(turn_on|turn_off|toggle|set_percentage)$/)"
            },
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            // Must be the server clock, so a command cannot be backdated past
            // the bridge's staleness check or postdated to fire later.
            "at": {
              ".validate": "newData.val() === now"
            },
            "data": {
              "brightness": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255" },
              "percentage": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "acl": {
      "viewers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      // A second tier on top of viewers: seeing the farm is not the same as
      // operating it. Written only by the service account.
      "controllers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
