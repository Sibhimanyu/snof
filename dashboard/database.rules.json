{
  "rules": {
    ".read": false,
    ".write": false,

    "farms": {
      "$farm": {
        ".read": "auth != null && root.child('acl/viewers').child(auth.uid).val() === true",
        ".write": false,

        // Append-only command queue: a client-writable path in the tree.
        // A controller may create a command and nothing else - no editing one,
        // no deleting one, no writing anywhere else under the farm. The bridge
        // on the NUC holds the only credential that can act on or remove one,
        // and re-applies its own domain allow-list, so a mistake here cannot by
        // itself reach a relay.
        // The target must also be a published entity. The bridge publishes
        // only entities that sit in a room, so this refuses a command for any
        // unassigned (or excluded, or invented) entity id outright - users
        // cannot operate what they cannot see. entity_id's regex forbids a
        // second '.', so the replace() yields exactly the object id.
        "commands": {
          "$cmd": {
            ".write": "auth != null && root.child('acl/controllers').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['entity_id','domain','service','uid','at']) && root.child('farms').child($farm).child('entities').child(newData.child('domain').val()).child(newData.child('entity_id').val().replace(newData.child('domain').val() + '.', '')).exists()",

            "entity_id": {
              ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().matches(/^[a-z_]+[.][a-z0-9_]+$/)"
            },
            // Only these five domains, and the domain must be the one the
            // entity_id names. climate is the ACs (owner, 2026-09-25). cover,
            // lock and alarm_control_panel are absent on purpose - operating a
            // gate or a door lock from a browser tab is a separate decision,
            // not a config tweak.
            "domain": {
              ".validate": "newData.isString() && newData.val().matches(/^(switch|light|fan|input_boolean|climate)$/) && newData.parent().child('entity_id').val().beginsWith(newData.val() + '.')"
            },
            // The set_* AC services only for climate; the bridge also holds
            // each to its one value.
            "service": {
              ".validate": "newData.isString() && (newData.val().matches(/^(turn_on|turn_off|toggle|set_percentage)$/) || (newData.val().matches(/^set_(temperature|hvac_mode|fan_mode|preset_mode)$/) && newData.parent().child('domain').val() === 'climate'))"
            },
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            // Must be the server clock, so a command cannot be backdated past
            // the bridge's staleness check or postdated to fire later.
            "at": {
              ".validate": "newData.val() === now"
            },
            "data": {
              "brightness": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255" },
              "percentage": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              // The ACs: °C, Home Assistant's own modes, and the AC's fan and
              // preset names (Home Assistant refuses one the AC lacks).
              "temperature": { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 35" },
              "hvac_mode": { ".validate": "newData.isString() && newData.val().matches(/^(off|heat|cool|heat_cool|auto|dry|fan_only)$/)" },
              "fan_mode": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,32}$/)" },
              "preset_mode": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,32}$/)" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        // Irrigation control: the one client path that can move water.
        // Admins only — not controllers — because it opens field valves.
        // Two actions: "run" (up to five valve numbers, 1–60 minutes; the
        // controller ends the run by itself) and "stop" (ends a manual run).
        // The bridge re-checks all of it, reads the controller first, refuses
        // anything but Irrigation valves, and spells the command itself from a
        // fixed template: nothing written here reaches Mobitech as text.
        // Off entirely unless allow_irrigation_control is set on the NUC.
        "irrigation_commands": {
          "$cmd": {
            // No second change until the first is confirmed (owner,
            // 2026-09-24): Mobitech accepts anything and cannot handle
            // conflicts, so while irrigation_lock is live — taken by the
            // consumer before it sends, released once the controller shows
            // the change, expiring by itself after 3 min — nothing may queue.
            ".write": "auth != null && root.child('acl/admins').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['action','uid','at']) && (newData.child('action').val() === 'stop' || newData.hasChildren(['valves','minutes'])) && (!root.child('farms').child($farm).child('irrigation_lock').exists() || root.child('farms').child($farm).child('irrigation_lock/until').val() < now)",
            "action": { ".validate": "newData.isString() && newData.val().matches(/^(run|stop)$/)" },
            "valves": { ".validate": "newData.isString() && newData.val().length <= 14 && newData.val().matches(/^[0-9]{1,2}(,[0-9]{1,2}){0,4}$/)" },
            "minutes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60 && newData.val() % 1 === 0" },
            "uid": { ".validate": "newData.val() === auth.uid" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        // Motor control: on or off for one water-chain motor (the river motor
        // on Livesky, the other farm's motors on Niagara). docs/motor-control.md.
        // Admins only. Refused unless meta/motorControl/enabled AND this motor's
        // meta/motorControl/motors/<motor> are true — both service account
        // only, off by default — and while meta/motorControl/lock is live (a change being
        // confirmed from the motor itself). The motor_command function
        // clientAt (the press, on the phone's corrected clock) must be within
        // 30 s of the server's now: a write queued offline is refused.
        // re-checks everything, reads the motor first, applies the rate
        // limits, sends once and never retries. Nothing written here reaches a
        // vendor as text: the two commands are fixed in the function.
        "motor_commands": {
          "$cmd": {
            ".write": "auth != null && root.child('acl/admins').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['motor','action','uid','at']) && root.child('farms').child($farm).child('meta/motorControl/enabled').val() === true && newData.child('motor').isString() && newData.child('motor').val().matches(/^[a-z0-9-]{1,40}$/) && root.child('farms').child($farm).child('meta/motorControl/motors').child(newData.child('motor').val()).val() === true && (!root.child('farms').child($farm).child('meta/motorControl/lock').exists() || root.child('farms').child($farm).child('meta/motorControl/lock/until').val() < now) && newData.child('clientAt').isNumber() && newData.child('clientAt').val() > now - 30000 && newData.child('clientAt').val() < now + 30000 && (newData.child('action').val() !== 'zone' || (newData.child('zone').exists() && root.child('farms').child($farm).child('meta/motorControl/zones').child(newData.child('motor').val()).val() === true)) && (newData.child('action').val() === 'zone' || !newData.child('zone').exists())",
            "clientAt": { ".validate": "newData.isNumber()" },
            // A zone change: continue the running program from zone 1-8 (the
            // zoned Niagara controller). Also needs meta/motorControl/zones/<motor>.
            "zone": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8 && newData.val() % 1 === 0" },
            "motor": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)" },
            "action": { ".validate": "newData.isString() && newData.val().matches(/^(on|off|zone)$/)" },
            "uid": { ".validate": "newData.val() === auth.uid" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        // Who is signed in to Mobitech, for the apps to show. Never the
        // token: that lives in /private/mobitech, which no client can read.
        // Written by the admin who signs in, in the same step as the token.
        // Written with the session above, so the owner alone.
        "mobitech_status": {
          ".write": "auth != null && auth.token.email != null && auth.token.email_verified === true && root.child('acl/owner/email').val() === auth.token.email.toLowerCase() && root.child('acl/admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['at', 'uid'])",
          "at": { ".validate": "newData.val() === now" },
          "uid": { ".validate": "newData.val() === auth.uid" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "user": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "mobileLast4": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)" },
          "$other": { ".validate": false }
        },

        // "Pull the water chain now": appended while someone has the Water
        // screen open. Any viewer may ask, because it only reads the river
        // and the other farm's motors (Livesky, Niagara). The water_refresh
        // function deletes the node, pulls at most once per 15 s whoever
        // asks, and does nothing while meta/water.enabled is not true. What
        // it reads lands in water/, which no client can write.
        "water_requests": {
          "$req": {
            ".write": "auth != null && root.child('acl/viewers').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['uid','at'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        // Add-on update requests: an admin asks the farm box to update its own
        // add-on (docs/nuc-access-and-deploy.md). Admins only, shape {uid, at}
        // and nothing else, at = server now. The bridge re-reads acl/admins,
        // drops anything older than 120 s, deletes every node, and does nothing
        // unless allow_remote_update is on and an update exists. Append-only:
        // no client edits or deletes. (Reads cascade from the farm's viewer
        // read; the nodes hold only a uid and a time, and live seconds.)
        "addon_update_requests": {
          "$req": {
            ".write": "auth != null && root.child('acl/admins').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['uid','at'])",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        // Report requests for the Mobitech DCON irrigation controller.
        // Same shape of trust as commands: a
        // controller may append a request and nothing else. A Cloud Function
        // (dashboard/functions) holds the vendor credentials in Secret
        // Manager, makes the calls, and writes the result to
        // irrigation_reports — which has no client write rule, so only the
        // service account can produce one. meta/reports.enabled, likewise
        // service-account-only, is its kill switch.
        // "type" is the report allow-list; "from"/"to" are optional
        // YYYY-MM-DD dates, required by the bridge for range reports. The
        // first three types are composites — one request, two controller
        // calls — so they are allow-listed by name here exactly like the
        // rest: a report that costs two calls is still one entry.
        "irrigation_requests": {
          "$req": {
            ".write": "auth != null && root.child('acl/controllers').child(auth.uid).val() === true && !data.exists() && newData.hasChildren(['type','uid','at'])",

            "type": {
              ".validate": "newData.isString() && newData.val().matches(/^(live_readings|session_log|performance|controller|electricity|pressure|valves|timer_log|motor_log|pressure_range|power_range|pressure_hour)$/)"
            },
            "from": {
              ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "to": {
              ".validate": "newData.isString() && newData.val().length <= 10 && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            // Must be the server clock, so a request cannot be backdated
            // past the bridge's staleness check or postdated to fire later.
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": { ".validate": false }
          }
        }
      }
    },

    // The Mobitech session token valve commands are sent with. Admins may
    // replace it (signing in to Mobitech from the dashboard or the app) and
    // nobody may read it: no ".read" anywhere here, and the root denies. The
    // NUC and the Cloud Function read it with their service accounts, which
    // rules do not apply to. Outside /farms on purpose, because a read grant
    // on a parent cannot be taken back on a child.
    "private": {
      // The Livesky session (a 24-hour JWT) and the river starter's IMEI.
      // Only the water_session function writes it, after an admin signs in
      // with an SMS code; only the water functions read it. No client may
      // do either: the explicit false is documentation, the root already
      // denies.
      "livesky": {
        ".write": false
      },
      // The owner alone signs SNOF in to Mobitech (owner, 2026-09-26: "the
      // super admin will be the only one to have to sign in, and everyone
      // else would just use those tokens"). One session per Mobitech
      // account: a second person signing in would end the first.
      "mobitech": {
        ".write": "auth != null && auth.token.email != null && auth.token.email_verified === true && root.child('acl/owner/email').val() === auth.token.email.toLowerCase() && root.child('acl/admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['token', 'at', 'uid'])",
        "token": { ".validate": "newData.isString() && newData.val().length >= 40 && newData.val().length <= 400 && newData.val().endsWith('@ios')" },
        "at": { ".validate": "newData.val() === now" },
        "uid": { ".validate": "newData.val() === auth.uid" },
        "$other": { ".validate": false }
      }
    },

    "acl": {
      // Admins can read the whole acl subtree in one shot (this cascades to
      // admins/viewers/controllers/directory below) so the in-dashboard admin
      // panel can list everyone. Nobody else gets a node above their own uid.
      ".read": "auth != null && root.child('acl/admins').child(auth.uid).val() === true",

      // The top tier. Deliberately not writable by any client, admins
      // included - promoting someone to admin is a security decision, the
      // same order as the two-tier split below, and stays a
      // service-account-only action (tools/grant-access.js --admin).
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      // The farm owner: the one person who signs SNOF in to Mobitech and
      // Livesky; everyone else uses those sessions through the functions and
      // the NUC. Anyone signed in may read it (the apps say who signs in).
      // Set from the command line only, like an admin.
      "owner": {
        ".read": "auth != null",
        ".write": false,
        "email": { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString()" }
      },
      "viewers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          // An admin may grant view (write true) or revoke it (delete). So
          // may the invited person themselves, exactly once, if an admin
          // left them an invite keyed by their own verified email claim -
          // this is what lets someone land with access already granted on
          // their very first sign-in, with nobody touching a terminal.
          ".write": "auth != null && (root.child('acl/admins').child(auth.uid).val() === true || (auth.uid === $uid && auth.token.email != null && root.child('acl/invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      },
      // A second tier on top of viewers: seeing the farm is not the same as
      // operating it.
      "controllers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          // Same self-claim path as viewers, gated on the invite itself
          // asking for control, not just view.
          ".write": "auth != null && (root.child('acl/admins').child(auth.uid).val() === true || (auth.uid === $uid && auth.token.email != null && root.child('acl/invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('tier').val() === 'control'))",
          // Granting control requires the target is already a viewer, so
          // control can never outrun view - true for an admin's grant and
          // for a self-claim alike, since the client sets viewer first.
          ".validate": "!newData.exists() || (newData.val() === true && root.child('acl/viewers').child($uid).val() === true)"
        }
      },
      // Self-registered on every sign-in (see app.js `enter()`), so an admin
      // can resolve a uid to an email without the Admin SDK. Presentation
      // only - nothing here is trusted for access control.
      "directory": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.hasChildren(['email', 'at'])",
          "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      },
      // Pre-authorization by email, so an admin never needs the command
      // line (or the Admin SDK) to add an ordinary viewer/controller: they
      // add someone here before that person has ever signed in. RTDB keys
      // cannot contain '.', so the key is the lowercased email with '.'
      // swapped for ',' - app.js does the same swap both ways.
      "invites": {
        "$key": {
          // An admin sees every invite (via the acl-level read above); the
          // invited person can see only their own, matched by their
          // Google-verified email claim - they have no uid yet to match on.
          ".read": "auth != null && (root.child('acl/admins').child(auth.uid).val() === true || (auth.token.email != null && $key === auth.token.email.toLowerCase().replace('.', ',')))",
          // Admins create or cancel an invite outright. The invited person
          // may only delete their own, once claimed - never create or edit
          // one for themselves.
          ".write": "auth != null && (root.child('acl/admins').child(auth.uid).val() === true || (!newData.exists() && auth.token.email != null && $key === auth.token.email.toLowerCase().replace('.', ',')))",
          "tier": { ".validate": "newData.isString() && (newData.val() === 'view' || newData.val() === 'control')" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
